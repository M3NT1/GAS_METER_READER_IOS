<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Vigavi</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>A gázóra leolvasásához a kamera eredeti fényképére van szükség.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>A meglévő gázóra fotók beolvasásához és digitális leolvasásához.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Az elkészített gázóra fotók mentéséhez a Fotók könyvtárba.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>A jóváhagyott gázóra-leolvasás helyi Home Assistant rendszerbe való feltöltéséhez szükséges.</string>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
